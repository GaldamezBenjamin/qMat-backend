### 1. Get All usuarios (Admin Only)
# Requires an admin token.
# If you don't have an admin token yet, you might get a 403 Forbidden.
GET {{$dotenv BASE_URL}}/usuarios
Authorization: Bearer {{$dotenv ADMIN_TOKEN}}

###

### 2. Create a User Profile (After Firebase Auth Registration)
# This assumes you've already registered the user via Firebase Auth on your frontend.
# The UID comes from the token of the *newly registered* user.
# The user's role is set here and also as a custom claim in Firebase Auth.
POST {{$dotenv BASE_URL}}/usuarios/profile
Content-Type: application/json
Authorization: Bearer {{$dotenv USER_TOKEN}}

{
    "username": "testuser_123",
    "email": "testuser_123@example.com",
    "rol": "usuario"
}

###

### 3. Get User By UID
# You can test with the UID of the user you just created or an admin's UID.
# A regular user can only get their own profile. An admin can get any profile.
GET {{$dotenv BASE_URL}}/usuarios/UID_OF_USER_TO_GET
Authorization: Bearer {{$dotenv USER_TOKEN}}

###

### 4. Update User Profile (Partial Update)
# Update some fields for an existing user.
# A user can only update their own profile. An admin can update any profile.
# Role cannot be changed by a non-admin.
PUT {{$dotenv BASE_URL}}/usuarios/UID_OF_USER_TO_UPDATE
Content-Type: application/json
Authorization: Bearer {{$dotenv USER_TOKEN}}

{
    "username": "updated_testuser",
    "email": "updated_testuser@example.com"
    // "rol": "admin" // Uncomment and use with an admin token to test role change
}

###

### 5. Update User Subscription
# Update the subscription status for a user.
# A user can only update their own subscription. An admin can update any.
PATCH {{$dotenv BASE_URL}}/usuarios/UID_OF_USER_TO_UPDATE/subscription
Content-Type: application/json
Authorization: Bearer {{$dotenv USER_TOKEN}}

{
    "suscrito": true,
    "fecha_inicio": "2025-06-01T00:00:00Z",
    "fecha_fin": "2026-06-01T00:00:00Z"
}

###

### 6. Update User Experience
# Update experience points for a user.
# A user can only update their own experience. An admin can update any.
PATCH {{$dotenv BASE_URL}}/usuarios/UID_OF_USER_TO_UPDATE/experience
Content-Type: application/json
Authorization: Bearer {{$dotenv USER_TOKEN}}

{
    "actual": 1500,
    "anterior": 1000
}

###

### 7. Delete User (Admin Only)
# This will delete the user from both Firestore and Firebase Authentication.
# Only accessible by an admin.
DELETE {{$dotenv BASE_URL}}/usuarios/UID_OF_USER_TO_DELETE
Authorization: Bearer {{$dotenv ADMIN_TOKEN}}

###