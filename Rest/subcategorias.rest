### Prerequisite: Create a Category First
# Ensure you have a category created, e.g., "Matemática" with ID "some_category_id_from_firestore"
# You can use the categories.rest file to create one if needed.

### 1. Get All Subcategories (Authenticated User)
GET {{$dotenv BASE_URL}}/subcategorias
Authorization: Bearer {{$dotenv USER_TOKEN}}

###

### 2. Create a New Subcategory (Admin Only)
# Replace YOUR_CATEGORY_ID_HERE with the actual ID of an existing category.
POST {{$dotenv BASE_URL}}/subcategorias
Content-Type: application/json
Authorization: Bearer {{$dotenv ADMIN_TOKEN}}

{
    "nombre": "Álgebra",
    "id_categoria": "YOUR_CATEGORY_ID_HERE"
}

###

### 3. Get Subcategory by ID (Authenticated User)
# Replace YOUR_SUBCATEGORY_ID_HERE with an actual subcategory ID from creation.
GET {{$dotenv BASE_URL}}/subcategorias/YOUR_SUBCATEGORY_ID_HERE
Authorization: Bearer {{$dotenv USER_TOKEN}}

###

### 4. Update Subcategory (Admin Only)
# Replace YOUR_SUBCATEGORY_ID_HERE with the ID of the subcategory to update.
# Replace YOUR_NEW_CATEGORY_ID_HERE if you want to change its parent category.
PUT {{$dotenv BASE_URL}}/subcategorias/YOUR_SUBCATEGORY_ID_HERE
Content-Type: application/json
Authorization: Bearer {{$dotenv ADMIN_TOKEN}}

{
    "nombre": "Geometría",
    "id_categoria": "YOUR_CATEGORY_ID_HERE"
    // "id_categoria": "YOUR_NEW_CATEGORY_ID_HERE" // Uncomment to test changing parent category
}

###

### 5. Delete Subcategory (Admin Only)
# Replace YOUR_SUBCATEGORY_ID_HERE with the ID of the subcategory to delete.
DELETE {{$dotenv BASE_URL}}/subcategorias/YOUR_SUBCATEGORY_ID_HERE
Authorization: Bearer {{$dotenv ADMIN_TOKEN}}

###