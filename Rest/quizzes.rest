### Prerequisite: Create Questions First
# You'll need existing question IDs to create a quiz.
# Use your questions.rest file to create a few questions.
# Example question IDs: "question_id_1", "question_id_2"

### 1. Get All Quizzes (Authenticated User)
GET {{$dotenv BASE_URL}}/quizzes
Authorization: Bearer {{$dotenv USER_TOKEN}}

###

### 2. Create a New Quiz (Admin Only)
# Replace YOUR_QUESTION_ID_1 and YOUR_QUESTION_ID_2 with actual existing question IDs.
POST {{$dotenv BASE_URL}}/quizzes
Content-Type: application/json
Authorization: Bearer {{$dotenv ADMIN_TOKEN}}

{
    "nombre": "Quiz de Álgebra Básica",
    "dificultad": "Baja",
    "cantidad_preguntas": 2,
    "tiempo_estimado": 5,
    "id_preguntas": [
        "YOUR_QUESTION_ID_1",
        "YOUR_QUESTION_ID_2"
    ]
}

###

### 3. Get Quiz by ID (Authenticated User)
# Replace YOUR_QUIZ_ID_HERE with an actual quiz ID from creation.
GET {{$dotenv BASE_URL}}/quizzes/YOUR_QUIZ_ID_HERE
Authorization: Bearer {{$dotenv USER_TOKEN}}

###

### 4. Update Quiz (Admin Only)
# Replace YOUR_QUIZ_ID_HERE with the ID of the quiz to update.
# Replace NEW_QUESTION_ID_1 and NEW_QUESTION_ID_2 with other existing question IDs.
PUT {{$dotenv BASE_URL}}/quizzes/YOUR_QUIZ_ID_HERE
Content-Type: application/json
Authorization: Bearer {{$dotenv ADMIN_TOKEN}}

{
    "nombre": "Quiz de Álgebra Intermedia",
    "dificultad": "Media",
    "cantidad_preguntas": 2,
    "tiempo_estimado": 8,
    "id_preguntas": [
        "NEW_QUESTION_ID_1",
        "NEW_QUESTION_ID_2"
    ]
}

###

### 5. Delete Quiz (Admin Only)
# Replace YOUR_QUIZ_ID_HERE with the ID of the quiz to delete.
DELETE {{$dotenv BASE_URL}}/quizzes/YOUR_QUIZ_ID_HERE
Authorization: Bearer {{$dotenv ADMIN_TOKEN}}

###