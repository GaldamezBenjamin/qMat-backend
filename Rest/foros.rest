### 1. Get All Forums (Authenticated User)
GET {{$dotenv BASE_URL}}/foros
Authorization: Bearer {{$dotenv USER_TOKEN}}

###

### 2. Create a New Forum (Any Authenticated User)
# This forum will be created by the user whose token is provided.
POST {{$dotenv BASE_URL}}/foros
Content-Type: application/json
Authorization: Bearer {{$dotenv USER_TOKEN}}

{
    "titulo": "Discusión sobre Álgebra Avanzada",
    "descripcion": "Un espacio para resolver dudas y compartir conocimientos sobre temas complejos de álgebra, incluyendo ecuaciones diferenciales."
}

###

### 3. Get Forum by ID (Authenticated User)
# Replace YOUR_FORUM_ID_HERE with an actual forum ID from creation.
GET {{$dotenv BASE_URL}}/foros/YOUR_FORUM_ID_HERE
Authorization: Bearer {{$dotenv USER_TOKEN}}

###

### 4. Update Forum (Only Creator or Admin)
# Replace YOUR_FORUM_ID_HERE with the ID of the forum to update.
# Use USER_TOKEN if updating a forum created by that user.
# Use ADMIN_TOKEN if updating any forum as an admin.
PUT {{$dotenv BASE_URL}}/foros/YOUR_FORUM_ID_HERE
Content-Type: application/json
Authorization: Bearer {{$dotenv USER_TOKEN}}

{
    "titulo": "Discusión de Álgebra y Geometría",
    "descripcion": "Un espacio para resolver dudas y compartir conocimientos sobre temas complejos de álgebra y geometría, incluyendo ecuaciones diferenciales y cálculo vectorial."
}

###

### 5. Delete Forum (Only Creator or Admin)
# Replace YOUR_FORUM_ID_HERE with the ID of the forum to delete.
# Use USER_TOKEN if deleting a forum created by that user.
# Use ADMIN_TOKEN if deleting any forum as an admin.
DELETE {{$dotenv BASE_URL}}/foros/YOUR_FORUM_ID_HERE
Authorization: Bearer {{$dotenv USER_TOKEN}}

###

### 6. Attempt to Update a Forum by a Non-Creator/Non-Admin (Should Fail with 403)
# Replace YOUR_FORUM_ID_HERE with the ID of a forum NOT created by 'ANOTHER_USER_TOKEN'.
# Use a token from a user different from the one who created the forum.
PUT {{$dotenv BASE_URL}}/foros/YOUR_FORUM_ID_HERE
Content-Type: application/json
Authorization: Bearer ANOTHER_USER_FIREBASE_ID_TOKEN_HERE

{
    "titulo": "Título Falso",
    "descripcion": "Descripción falsa para intentar modificar."
}

###