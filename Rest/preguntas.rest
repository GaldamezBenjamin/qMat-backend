### Prerequisite: Create a Subcategory First
# You'll need a subcategory ID to link questions to.
# Use your sub_categories.rest file to create one if needed.
# Example subcategory ID: "some_math_subcategory_id"

### 1. Get All Questions (Admin Only)
GET {{$dotenv BASE_URL}}/preguntas
Authorization: Bearer {{$dotenv ADMIN_TOKEN}}

###

### 2. Create a New Question (Admin Only)
# Replace YOUR_SUBCATEGORY_ID_HERE with the actual ID of an existing subcategory.
POST {{$dotenv BASE_URL}}/preguntas
Content-Type: application/json
Authorization: Bearer {{$dotenv ADMIN_TOKEN}}

{
    "enunciado": "¿Cuál es el resultado de 2 + 2?",
    "dificultad": "Baja",
    "opciones": {
        "a": "3",
        "b": "4",
        "c": "5",
        "d": "6",
        "correcta": "b"
    },
    "id_subcategoria": "YOUR_SUBCATEGORY_ID_HERE"
}

###

### 3. Get Questions by Subcategory ID (Authenticated User)
# Replace YOUR_SUBCATEGORY_ID_HERE with the ID of an existing subcategory.
GET {{$dotenv BASE_URL}}/preguntas/subcategory/YOUR_SUBCATEGORY_ID_HERE
Authorization: Bearer {{$dotenv USER_TOKEN}}

###

### 4. Get a Specific Question by ID (Authenticated User)
# Replace YOUR_QUESTION_ID_HERE with an actual question ID from creation.
GET {{$dotenv BASE_URL}}/preguntas/YOUR_QUESTION_ID_HERE
Authorization: Bearer {{$dotenv USER_TOKEN}}

###

### 5. Update a Question (Admin Only)
# Replace YOUR_QUESTION_ID_HERE with the ID of the question to update.
PUT {{$dotenv BASE_URL}}/preguntas/YOUR_QUESTION_ID_HERE
Content-Type: application/json
Authorization: Bearer {{$dotenv ADMIN_TOKEN}}

{
    "enunciado": "¿Cuál es el resultado de 2 x 2?",
    "dificultad": "Media",
    "opciones": {
        "a": "2",
        "b": "4",
        "c": "6",
        "d": "8",
        "correcta": "b"
    }
    // "id_subcategoria": "ANOTHER_SUBCATEGORY_ID_HERE" // Uncomment to test changing subcategory
}

###

### 6. Delete a Question (Admin Only)
# Replace YOUR_QUESTION_ID_HERE with the ID of the question to delete.
DELETE {{$dotenv BASE_URL}}/preguntas/YOUR_QUESTION_ID_HERE
Authorization: Bearer {{$dotenv ADMIN_TOKEN}}

###